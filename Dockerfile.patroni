FROM postgres:15-alpine

ARG POSTGRES_EXPORTER_PASSWORD

RUN apk add --no-cache gettext

RUN apk add --no-cache \
    postgresql-plpython3 \
    python3 \
    python3-dev \
    py3-pip \
    py3-faker \
    py3-psycopg2 \
    curl \
    bash \
    sudo

RUN pip3 install --break-system-packages \
    --index-url https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com \
    patroni[etcd]

RUN id -u postgres &>/dev/null || useradd -u 999 -m -s /bin/bash postgres

RUN mkdir -p /docker-entrypoint-initdb.d /etc/patroni /var/lib/postgresql/data

RUN chown -R postgres:postgres /var/lib/postgresql /etc/patroni /docker-entrypoint-initdb.d

RUN cat > /docker-entrypoint-initdb.d/00_install_plpython.sql << 'EOF'
CREATE EXTENSION IF NOT EXISTS plpython3u;
EOF

RUN cat > /docker-entrypoint-initdb.d/01_create_monitoring_user.sql << EOF

DO \$\$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'postgres_exporter') THEN
        CREATE USER postgres_exporter WITH PASSWORD '${POSTGRES_EXPORTER_PASSWORD}';
        RAISE NOTICE 'User postgres_exporter created';
    ELSE
        ALTER USER postgres_exporter WITH PASSWORD '${POSTGRES_EXPORTER_PASSWORD}';
        RAISE NOTICE 'User postgres_exporter password updated';
    END IF;
END \$\$;

ALTER USER postgres_exporter SET SEARCH_PATH TO postgres_exporter,pg_catalog;
GRANT CONNECT ON DATABASE ${POSTGRES_DB} TO postgres_exporter;
GRANT pg_monitor TO postgres_exporter;

EOF

COPY scripts/patroni-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY patroni/config.yml.template /etc/patroni/config.yml.template
RUN chown postgres:postgres /etc/patroni/config.yml.template

USER postgres

ENTRYPOINT ["/entrypoint.sh"]